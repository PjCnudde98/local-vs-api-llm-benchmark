# --- Claude (cloud variants, JUDGE) ---------------------------------------------
# Microsoft Foundry: set both. Without them the Claude API is used (ANTHROPIC_API_KEY).
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=
# ANTHROPIC_API_KEY=
# JUDGE_CLAUDE_MODEL=claude-opus-5-5

# --- Azure OpenAI (GPT variants, JUDGE_GPT) -------------------------------------
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_DEPLOYMENT_GPT=<deployment name of the newest mid-tier GPT, EU Data Zone Standard>
AZURE_DEPLOYMENT_GPT_LABEL=<display name, e.g. the model version>
AZURE_DEPLOYMENT_JUDGE=<deployment name of a GPT judge model>

# --- OpenAI API (JUDGE_OPENAI: the second judge when there is no Azure deployment) ---
# OPENAI_API_KEY=
# OPENAI_JUDGE_MODEL=<a current GPT model id>

# --- Local servers (OpenAI-compatible: vLLM, llama.cpp llama-server, SGLang, Ollama) ---
# Model names must match what the server calls the model. Defaults are in config/variants.yaml.
LOCAL_API_KEY=not-needed
LOCAL_TIMEOUT_S=600

# XL server: >128 GB (512 GB RAM + GPUs). One model loaded at a time; see docs/models.md.
XL_SERVER_BASE_URL=http://<xl-server>:8080/v1
XL_GLM_MODEL=glm-5.3
XL_DEEPSEEK_MODEL=deepseek-v4.1-flash
XL_KIMI_MODEL=kimi-k2.6
XL_QWEN_MODEL=qwen3.8-flash-next

# Large: 80 GB+ GPU
LOCAL_LARGE_BASE_URL=http://localhost:8000/v1
LOCAL_MISTRAL_SMALL_4_MODEL=mistral-small-4

# Medium: one 24-48 GB GPU
LOCAL_GPU_BASE_URL=http://localhost:8000/v1
LOCAL_QWEN36_27B_MODEL=qwen3.6:27b
LOCAL_GEMMA4_26B_MODEL=gemma4:26b
LOCAL_GPT_OSS_MODEL=gpt-oss:20b

# Small: laptop (Ollama default port)
LOCAL_SMALL_BASE_URL=http://localhost:11434/v1
LOCAL_GEMMA4_12B_MODEL=gemma4:12b
LOCAL_SMALL_MODEL=qwen3:8b
