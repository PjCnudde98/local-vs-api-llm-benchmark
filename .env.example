# Azure AI Foundry / Azure OpenAI (variants A, B, judge)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_DEPLOYMENT_FRONTIER=<deployment name of the frontier model>
AZURE_DEPLOYMENT_JUDGE=<deployment name of a judge model, ideally another family>

# Local serving (variants C, D). vLLM default shown; Ollama is http://localhost:11434/v1
LOCAL_MID_BASE_URL=http://localhost:8000/v1
LOCAL_MID_MODEL=<e.g. a 20-35B instruct model>
LOCAL_SMALL_BASE_URL=http://localhost:11434/v1
LOCAL_SMALL_MODEL=<e.g. a 7-9B instruct model>

# Optional variant E: same mid model on a GPU VM in your own Azure subscription
AZURE_VM_BASE_URL=http://<vm>:8000/v1
